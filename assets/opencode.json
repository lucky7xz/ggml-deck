{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (Local)",
      "options": {
        "baseURL": "http://127.0.0.1:8033/v1",
        "apiKey": "sk-no-key-required"
      },
      "models": {
        "gemma-4-local": {
          "name": "Gemma 4 (Local CPU)"
        }
      }
    },
    "llama-gpu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (GPU Server)",
      "options": {
        "baseURL": "http://192.168.xxx.xx:8033/v1",
        "apiKey": "sk-no-key-required"
      },
      "models": {
        "gemma-4-gpu": {
          "name": "Gemma 4 (GPU Server)"
        }
      }
    }
  }
}
